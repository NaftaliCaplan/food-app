EXPO_PUBLIC_PROXY_URL=
EXPO_PUBLIC_APP_SHARED_SECRET=
# Sentry crash/error reporting DSN — safe to leave blank locally (Sentry.init
# below no-ops without one); get a real value from sentry.io once a project
# exists. Not a secret (DSNs are write-only ingest keys), still EXPO_PUBLIC_
# for consistency with the other client-bundled values above.
EXPO_PUBLIC_SENTRY_DSN=
